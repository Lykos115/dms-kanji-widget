{
    "id": "kanjiWidget",
    "name": "JLPT Kanji",
    "description": "Rotates through JLPT kanji (N5–N1) with on/kun readings and meanings. Bar pill with a popout card, and a desktop widget. Plays the readings aloud.",
    "version": "0.1.0",
    "author": "lykos",
    "type": "composite",
    "capabilities": ["dankbar-widget", "desktop-widget", "japanese", "study"],
    "icon": "translate",
    "components": {
        "widget": "./KanjiBarWidget.qml",
        "desktop": "./KanjiDesktopWidget.qml"
    },
    "settings": "./KanjiSettings.qml",
    "requires_dms": ">=1.5.0",
    "permissions": ["settings_read", "settings_write"]
}
